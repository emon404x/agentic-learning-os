{
  "mcpServers": {
    "local-files": {
      "command": "python",
      "args": ["scripts/stardi.py", "ingest"]
    },
    "sqlite-knowledge-db": {
      "command": "sqlite-mcp-server",
      "args": ["./stardi_workspace/knowledge.db"],
      "env": {
        "DB_READONLY": "true"
      }
    },
    "github-repo": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_TOKEN_IN_ENV>"
      }
    },
    "official-docs": {
      "url": "https://mcp.example.org/official-docs/mcp"
    }
  }
}
