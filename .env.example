# Stardi AI Learning Operating System — Environment Configuration Example
# Copy this file to `.env` and fill in optional values. Never commit `.env` to version control.

# Optional: ElevenLabs API key for natural two-host dialogue synthesis (eleven_v3).
# Leave empty to use built-in offline system voices (macOS `say` or Windows `System.Speech`) or text-only mode.
ELEVENLABS_API_KEY=

# Optional: Override ElevenLabs voice IDs and stability (0.0 to 1.0)
CLAUDEMY_VOICE_A=TX3LPaxmHKxFdv7VOQHJ
CLAUDEMY_VOICE_B=cgSgspJ2msm6clMCkdW9
CLAUDEMY_STABILITY=0.3

# Optional: Override offline OS voice names (macOS `say` or Windows SAPI `System.Speech`)
# macOS defaults: Samantha / Daniel
# Windows defaults: Microsoft Zira Desktop / Microsoft David Desktop
CLAUDEMY_SAY_A=
CLAUDEMY_SAY_B=
